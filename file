    <!-- Interactive JS Core -->
    <script>
        // Init Lucide Icons
        lucide.createIcons();

        // Global State variables for the Simulation
        let L = 1800; // Carrying Capacity
        let k = 0.055; // Growth rate factor
        let t0 = 95; // Inflection day
        let activeIndex = 55; // Initial highlight day
        let chartInstance = null;

        // Dom Elements references
        const sliderL = document.getElementById('sliderL');
        const sliderK = document.getElementById('sliderK');
        const sliderT0 = document.getElementById('sliderT0');

        const valL = document.getElementById('valL');
        const valK = document.getElementById('valK');
        const valT0 = document.getElementById('valT0');

        const calcDayLabel = document.getElementById('calcDayLabel');
        const outWeight = document.getElementById('outWeight');
        const outGrade = document.getElementById('outGrade');
        const outRate = document.getElementById('outRate');
        const outMaturity = document.getElementById('outMaturity');
        const outMaturityDesc = document.getElementById('outMaturityDesc');
        const maturityIndexIndicator = document.getElementById('maturityIndexIndicator');
        const laymanExplanation = document.getElementById('laymanExplanation');

        // Math Logic: Sigmoid Logistic Weight Equation f(t)
        function f(t) {
            return L / (1 + Math.exp(-k * (t - t0)));
        }

        // Math Logic: First Derivative Equation f'(t)
        function fPrime(t) {
            const expTerm = Math.exp(-k * (t - t0));
            return (L * k * expTerm) / Math.pow(1 + expTerm, 2);
        }

        // Generate Dataset Array
        function generateData() {
            const labels = [];
            const dataWeight = [];
            const dataRate = [];
            // Growth phase observed between day 40 and 160 after induction
            for (let t = 40; t <= 160; t += 2) {
                labels.push(t);
                dataWeight.push(f(t));
                dataRate.push(fPrime(t));
            }
            return { labels, dataWeight, dataRate };
        }

        // Calculate metrics for selected target point
        function updateSolverMetrics(t) {
            const weight = f(t);
            const rate = fPrime(t);

            // Update text elements
            calcDayLabel.textContent = Day ${t};
            outWeight.textContent = weight.toFixed(1);
            outRate.textContent = rate.toFixed(2);

            // Grade logic based on FAMA / MPIB rules
            let grade = "";
            if (weight >= 1700) {
                grade = "Grade A (Premium Export Sizing)";
            } else if (weight >= 1300) {
                grade = "Grade B (Standard Market Sizing)";
            } else {
                grade = "Grade C (Processing / Juice Grade)";
            }
            outGrade.textContent = Est. Grade: ${grade};

            // Maturity analysis and colorization
            let color = "bg-rose-500";
            let maturityLabel = "";
            let description = "";
            let laymanText = "";

            if (t < 80) {
                color = "bg-red-500 animate-ping";
                maturityLabel = "Phase 1: Cell Division";
                description = "Rapid cell multiplication. Fruit holds high concentration of organic acids.";
                laymanText = At Day ${t}, the pineapple is in its early division stage, weighing only ${weight.toFixed(0)}g. Its rate of growth is ${rate.toFixed(1)} g/day. Structurally, the fruit syncarp is still forming; cell expansion has not peaked. Applying high phosphorus fertilizer here is optimal.;
            } else if (t >= 80 && t < 115) {
                color = "bg-amber-400";
                maturityLabel = "Phase 2: Cell Elongation (Peak Dynamics)";
                description = "Maximum water and sugar accumulation is happening right now.";
                laymanText = At Day ${t}, you are witnessing peak biological velocity! The pineapple is packing on weight at ${rate.toFixed(1)} grams per day. This is the inflection point where potassium demand is vital. Harvest now would fail standard Brix tests.;
            } else if (t >= 115 && t < 140) {
                color = "bg-yellow-400";
                maturityLabel = "Maturity Index 1: Light Green";
                description = "Mature-unripe. Ready for long-distance ocean shipping.";
                laymanText = At Day ${t}, the instantaneous growth derivative decreases to ${rate.toFixed(1)} g/day. Biomass has stabilized at ${weight.toFixed(0)}g. Starch is converting to simple sugars. Under MPIB standards, this index is perfect for maritime export to Western Asia.;
            } else if (t >= 140 && t <= 150) {
                color = "bg-orange-500";
                maturityLabel = "Maturity Index 3-4: Golden Base";
                description = "Optimal harvest index for direct air shipping and immediate consumption.";
                laymanText = At Day ${t}, the growth rate has flattened significantly (${rate.toFixed(1)} g/day) as we approach carrying capacity. Total Soluble Solids are at their peak (&gt;14° Brix), and organic acids are minimal. Harvest this immediately for premium local distribution.;
            } else {
                color = "bg-amber-900";
                maturityLabel = "Maturity Index 6-7: Overripe";
                description = "Excess sucrose conversion. Fermentation risk is elevated.";
                laymanText = At Day ${t}, growth velocity has dropped to an almost inactive ${rate.toFixed(1)} g/day. The fruit has surpassed premium freshness. It must be redirected for industrial juice processing or lactic acid fermentation at your Agro-processing lab.;
            }

            maturityIndexIndicator.className = w-4 h-4 rounded-full ${color};
            outMaturity.textContent = maturityLabel;
            outMaturityDesc.textContent = description;
            laymanExplanation.innerHTML = laymanText;
        }

        // Render / Update Chart.js Instance
        function renderChart() {
            const { labels, dataWeight, dataRate } = generateData();

            if (chartInstance) {
                chartInstance.destroy();
            }

            const ctx = document.getElementById('growthChart').getContext('2d');
            
            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Fruit Mass f(t) (g)',
                            data: dataWeight,
                            borderColor: '#059669', // Emerald 600
                            borderWidth: 3,
                            backgroundColor: 'rgba(5, 150, 105, 0.05)',
                            fill: true,
                            yAxisID: 'yWeight',
                            tension: 0.15,
                            pointRadius: labels.map(day => day === activeIndex ? 8 : 1),
                            pointBackgroundColor: labels.map(day => day === activeIndex ? '#ffffff' : '#059669'),
                            pointBorderColor: labels.map(day => day === activeIndex ? '#10b981' : 'transparent'),
                            pointBorderWidth: 3,
                        },
                        {
                            label: "Daily Growth Rate f'(t) (g/day)",
                            data: dataRate,
                            borderColor: '#f59e0b', // Amber 500
                            borderWidth: 2,
                            borderDash: [5, 5],
                            yAxisID: 'yRate',
                            tension: 0.15,
                            pointRadius: labels.map(day => day === activeIndex ? 8 : 1),
                            pointBackgroundColor: labels.map(day => day === activeIndex ? '#ffffff' : '#f59e0b'),
                            pointBorderColor: labels.map(day => day === activeIndex ? '#f59e0b' : 'transparent'),
                            pointBorderWidth: 3,
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    onClick: (event, elements) => {
                        if (elements && elements.length > 0) {
                            const index = elements[0].index;
                            const clickedDay = labels[index];
                            activeIndex = clickedDay;
                            updateSolverMetrics(clickedDay);
                            renderChart(); // Redraw chart with highlighted point
                        }
                    },
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: 'Days After Flower Induction (Days)',
                                color: '#475569',
                                font: {
                                    weight: 'bold',
                                    family: 'Plus Jakarta Sans'
                                }
                            },
                            grid: {
                                color: 'rgba(148, 163, 184, 0.08)'
                            }
                        },
                        yWeight: {
                            type: 'linear',
                            position: 'left',
                            title: {
                                display: true,
                                text: 'Cumulative Mass (grams)',
                                color: '#059669',
                                font: {
                                    weight: 'bold'
                                }
                            },
                            grid: {
                                color: 'rgba(148, 163, 184, 0.08)'
                            },
                            min: 0,
                            max: 2600
                        },
                        yRate: {
                            type: 'linear',
                            position: 'right',
                            title: {
                                display: true,
                                text: 'Weight Accrual Velocity (g/day)',
                                color: '#f59e0b',
                                font: {
                                    weight: 'bold'
                                }
                            },
                            grid: {
                                drawOnChartArea: false // Prevents overlapping gridlines
                            },
                            min: 0,
                            max: 60
                        }
                    },
                    plugins: {
                        legend: {
                            display: false // Using custom legends
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.dataset.label || '';
                                    return ` ${label}: ${context.parsed.y.toFixed(2)}`;
                                }
                            }
                        }
                    }
                }
            });
        }

        // Handle tabs swapping
        function switchTab(tabId) {
            document.getElementById('tab-standards').classList.add('hidden');
            document.getElementById('tab-calculus').classList.add('hidden');
            
            document.getElementById('btn-tab-standards').className = "border-b-2 border-transparent text-slate-500 hover:text-emerald-700 pb-4 text-sm transition-all";
            document.getElementById('btn-tab-calculus').className = "border-b-2 border-transparent text-slate-500 hover:text-emerald-700 pb-4 text-sm transition-all";

            document.getElementById(tabId).classList.remove('hidden');
            document.getElementById('btn-' + tabId).className = "border-b-2 border-emerald-600 text-emerald-950 font-bold pb-4 text-sm transition-all";
        }

        // Real-time Event Listeners for agricultural sliders
        sliderL.addEventListener('input', (e) => {
            L = parseFloat(e.target.value);
            valL.textContent = ${L} g;
            updateSolverMetrics(activeIndex);
            renderChart();
        });

        sliderK.addEventListener('input', (e) => {
            k = parseFloat(e.target.value);
            valK.textContent = k.toFixed(3);
            updateSolverMetrics(activeIndex);
            renderChart();
        });

        sliderT0.addEventListener('input', (e) => {
            t0 = parseInt(e.target.value);
            valT0.textContent = ${t0} Days;
            updateSolverMetrics(activeIndex);
            renderChart();
        });

        // Initialize App on Window Load
        window.onload = function() {
            updateSolverMetrics(activeIndex);
            renderChart();
        }
    </script>
</body>
</html>
